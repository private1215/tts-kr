[Unit]
Description=Qwen3-TTS Web Service
# 关键：/mnt/tts 在 fstab 里是 nofail，若服务先于挂载启动，
# 会把模型和音频写到根分区（系统盘）。显式声明挂载依赖，保证挂载完成后才启动。
RequiresMountsFor=/mnt/tts
After=network-online.target mnt-tts.mount
Wants=network-online.target
# tailscale 先起来，避免重启后几分钟内 tailscale IP 访问不通
After=tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/tts/projects/qwen3-tts/app
Environment=PATH=/mnt/tts/projects/qwen3-tts/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
# 数据/模型根目录。换服务器时只需改这一行（代码里所有路径都由它派生），
# 改完记得同步改上面 PATH / WorkingDirectory / ExecStart / 日志路径，以及 RequiresMountsFor。
# 删除此行则回落到代码默认值 /mnt/tts。
Environment=TTS_BASE=/mnt/tts
# ⚠️ 双显卡时锁死具体哪张卡，必须写 UUID，不要写序号。
# 本机 nvidia-smi 与 torch 的编号是反的：
#   nvidia-smi  index 0 = RTX 3060 (12G, PCI 03:00.0)
#                index 1 = RTX 3090 (24G, PCI 04:00.0)
#   torch.device  0 = RTX 3090（CUDA 默认 FASTEST_FIRST，按算力强弱排）
#               1 = RTX 3060
# 写序号会踩错卡。换机换卡时用 nvidia-smi --query-gpu=index,name,uuid --format=csv 重取。
# 当前策略：先用 12G 的 3060，与旧机显存条件一致，便于复现历史性能基线。
# ⚠️ ASR 回检（faster-whisper）的 HF 缓存位置必须显式钉死。
# 服务以 root 运行，而模型当初是 zheng 用户下的 → root 的 HOME=/root 找不到缓存，
# local_files_only=True 直接抛错 → 转写返回空串 → CER 恒为 0 且标记 skipped，
# 「内容跑飞」一条都抓不到（表现为仿真度回检全程静默失效）。
# 放到 /mnt/tts 下还有个好处：与项目「所有数据都在 /mnt/tts」一致，
# 不再受运行用户 HOME 变化影响。缓存结构必须是 HF_HOME/hub/models--*。
Environment=HF_HOME=/mnt/tts/models/asr
Environment=HF_HUB_OFFLINE=1
Environment=CUDA_VISIBLE_DEVICES=GPU-94853612-464c-9177-c374-a9a82e321229
# PyTorch 缓存分配器调优：服务长期不重启时 reserved 会碎片化累积，
# 实测 service.log 里出现过 "2.15 GiB reserved but unallocated" 导致的假性 OOM。
# expandable_segments：创建可动态扩展的内存段，从根源减少碎片（PyTorch 官方首推）
# garbage_collection_threshold=0.8：占用率达 80% 时主动回收空闲块
# 注意：不要与 max_split_size_mb 同时设置，两者在官方文档中被标记为互斥。
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.8
# ---- 韵律移植（PROSO）：F0 重映射，把 A 句内动态 / E 句尾多样性拉到案例值 ----
# r13（2026-10-06）上线。实现见 app/proso.py（Praat PSOLA，经 parselmouth 调用）。
# 验收（vs ElevenLabs 标杆，整篇同文案）：
#   女声 六维全部进 ±10%，E 由 -29.8% 修到 -3.9%（最难的一项）
#   男声 A +12.3% / E -16.0% —— 未达标，见下方「已知偏差」
# ⚠️ 只在整段字数 >= TTS_PROSO_MIN_CHARS（默认 120）时触发，短句不受影响也不耗时。
# ⚠️ 代价：PSOLA 是重合成。女声 RTF 由 0.576 升到 0.727（+26%），男声 0.531→0.534 基本不变。
#    按日产 80 条算，女声任务排队时间会变长，产能评估要把这个算进去。
# ⚠️ 已知偏差（下一轮修）：Praat 口径算 k、pyin 口径验收，两者换算系数在重合成后失效
#    （案例两口径比值 1.136，我们处理后只有 1.011），导致男声 A/E 没到位。
#    修法是按实测反推校准目标值，不要改成迭代求解。
# 回滚（A/B 用，重启后恢复本文件的 1）：
#    systemctl set-environment TTS_PROSO=0 && systemctl restart qwen-tts
Environment=TTS_PROSO=1
ExecStart=/mnt/tts/projects/qwen3-tts/venv/bin/python -u server.py
Restart=always
RestartSec=10
StandardOutput=append:/mnt/tts/projects/qwen3-tts/service.log
StandardError=append:/mnt/tts/projects/qwen3-tts/service.log

[Install]
WantedBy=multi-user.target
